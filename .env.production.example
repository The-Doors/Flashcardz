GHCR_OWNER=the-doors
APP_DOMAIN=cardz.cards
SUPABASE_DOMAIN=supabase.cardz.cards

APP_NAME=Flashcardz
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://cardz.cards
OCTANE_SERVER=frankenphp
OCTANE_HTTPS=true

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=supabase-db
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
# Copy POSTGRES_PASSWORD from supabase/production/.env on the VM.
DB_PASSWORD='replace-with-your-generated-postgres-password'
# Postgres is reached over the private Docker network and has no public port.
DB_SSLMODE=disable

CACHE_STORE=database
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=960
ZENROWS_API_KEY=
FILESYSTEM_DISK=local

SUPABASE_URL=https://supabase.cardz.cards
SUPABASE_JWKS_URL=http://auth:9999/.well-known/jwks.json
SUPABASE_JWKS_CACHE_STORE=file
