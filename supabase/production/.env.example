# Generated by setup.sh on the VM. Keep the resulting .env private and backed up.
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=
JWT_KEYS=
JWT_JWKS=
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=
SECRET_KEY_BASE=
REALTIME_DB_ENC_KEY=
VAULT_ENC_KEY=
PG_META_CRYPTO_KEY=
LOGFLARE_PUBLIC_ACCESS_TOKEN=
LOGFLARE_PRIVATE_ACCESS_TOKEN=
S3_PROTOCOL_ACCESS_KEY_ID=
S3_PROTOCOL_ACCESS_KEY_SECRET=
MINIO_ROOT_PASSWORD=

SUPABASE_PUBLIC_URL=https://supabase.cardz.cards
API_EXTERNAL_URL=https://supabase.cardz.cards/auth/v1
SITE_URL=https://cardz.cards
ADDITIONAL_REDIRECT_URLS=https://cardz.cards/auth-callback
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=10
POOLER_MAX_CLIENT_CONN=100
POOLER_TENANT_ID=flashcardz
POOLER_DB_POOL_SIZE=5
STUDIO_DEFAULT_ORGANIZATION=Flashcardz
STUDIO_DEFAULT_PROJECT=Flashcardz
OPENAI_API_KEY=
JWT_EXPIRY=3600
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false

# Verify cardz.cards in Resend, then fill SMTP_PASS with a sending API key.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=replace-with-resend-api-key
SMTP_ADMIN_EMAIL=noreply@cardz.cards
SMTP_SENDER_NAME=Flashcardz
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

# Optional: Google sign-in also needs the new callback in Google Cloud Console.
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=

GLOBAL_S3_BUCKET=stub
REGION=stub
STORAGE_TENANT_ID=flashcardz
IMGPROXY_AUTO_WEBP=true
FUNCTIONS_VERIFY_JWT=true
FUNCTIONS_MEMORY_LIMIT=512m
PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public
